# Yaqot: production settings for InfinityFree (see docs/DEPLOY.md).
# Copy this file to `.env` ON THE SERVER, fill in the blanks, and never commit the result.
# A value with a space or a # must be in "double quotes".

APP_NAME=Yaqot
APP_ENV=production
# Generate on your own computer: php artisan key:generate --show   (paste the whole value it prints)
APP_KEY=
APP_DEBUG=false
# The address visitors use, with https and no trailing slash. The site only answers to this host
# and its subdomains (trusted hosts), and it builds the canonical, sitemap and upload URLs.
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# `php artisan down` needs a shell: to put the site in maintenance mode, see docs/DEPLOY.md.
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# A dated log file per day, only the last 7 kept (each file counts against the host's file limit).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=7
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# From the MySQL Databases page of the InfinityFree control panel (the host is NOT localhost).
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sessions and cache in the database: no file per visitor (the host limits the number of files).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies only over https, never readable by scripts, not sent on cross-site requests.
# While the site is still on http:// (before SSL works) set SESSION_SECURE_COOKIE=false, or nobody can log in.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync

# No symlinks on the host: uploads are written straight into the real folder public/uploads
# and served at /uploads. Do not change this after the first upload without moving the files.
FILESYSTEM_DISK=local
PUBLIC_DISK_ROOT=uploads

# The admin has no password reset and the site sends no mail.
MAIL_MAILER=log
