# Uploaded product images. They are only ever read, so no script in here may run, and
# nothing may be listed.
Options -Indexes
<FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|cgi|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
